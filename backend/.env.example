# 1. Create a free Groq API key at https://console.groq.com/keys
# 2. Copy this file to .env in the backend folder and set LLM_API_KEY.
# Never paste a key into React source or commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=15
# Multilingual embeddings (Indonesian and English). No paid embedding API needed.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
